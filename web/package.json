{
  "name": "hindsight-lens-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Lens dashboard. `pnpm build` writes one self-contained file to ../lens/dashboard.html, which Lens serves; no Node at runtime.",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "vite --port 8907 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src index.html",
    "check": "prettier --check src index.html && tsc --noEmit && vitest run",
    "build": "pnpm check && vite build && cp dist/index.html ../lens/dashboard.html"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@remixicon/react": "^4.5.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "merge-refs": "^1.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite": "^6",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^3"
  }
}
